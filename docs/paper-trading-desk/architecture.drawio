        <mxCell id="legend" value="Legend: blue = UI state  |  blue service boxes = OMS/Market-owned data  |  green = real-time market data  |  red = correctness guard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1320" height="38" as="geometry"/></mxCell>

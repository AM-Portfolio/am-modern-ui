        <mxCell id="orders" value="Orders&#10;orderId&#10;status / side / qty&#10;fillPrice / rejectReason&#10;owner from JWT" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="230" height="145" as="geometry"/></mxCell>
        <mxCell id="positions" value="Positions&#10;symbol / qty / average = OMS truth&#10;LTP = REST snapshot then valid tick&#10;derived live P&amp;L&#10;Exit = confirmed opposite-side ticket" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="230" height="145" as="geometry"/></mxCell>

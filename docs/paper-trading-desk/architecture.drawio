        <mxCell id="isolation" value="Trust rule&#10;PAPER wallet/order must not mutate LIVE or OPTION books" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="e1" value="Bearer" style="endArrow=block;html=1;strokeColor=#82B366;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell>

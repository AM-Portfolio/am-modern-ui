        <mxCell id="s1" value="Keep loading shell; emit OMS error/retry; do not choose desk/enable from assumptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="330" height="90" as="geometry"/></mxCell>

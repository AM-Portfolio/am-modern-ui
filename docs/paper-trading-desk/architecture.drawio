        <mxCell id="uiState" value="UI resource state&#10;loading ≠ empty&#10;ready-empty = confirmed zero&#10;error = retryable&#10;stale = labeled/never silently guessed" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#1168BD;strokeColor=#0B4F8A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="470" width="310" height="155" as="geometry"/></mxCell>
        <mxCell id="rule" value="Order safety rule&#10;No positive confirmed LTP → no order submission&#10;No fabricated symbol, balance, position, or price" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="350" height="125" as="geometry"/></mxCell>

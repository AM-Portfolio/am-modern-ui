        <mxCell id="purpose" value="Purpose: every delayed or failed dependency produces an explicit user outcome rather than a guessed value." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#333333;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1100" height="30" as="geometry"/></mxCell>

  <diagram id="security" name="SecurityTrust">
    <mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="850">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Paper Trading Desk — Security and Trust Boundaries" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#1A1A2E;fontColor=#FFFFFF;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1300" height="55" as="geometry"/></mxCell>
        <mxCell id="purpose" value="Purpose: preserve owner-scoped Paper isolation while requests are made progressively." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#333333;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="950" height="30" as="geometry"/></mxCell>
        <mxCell id="user" value="Authenticated user" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="60" height="100" as="geometry"/></mxCell>
        <mxCell id="ui" value="Paper UI&#10;SecureStorage Bearer token&#10;Idempotency-Key on order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4F8A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="250" height="145" as="geometry"/></mxCell>
